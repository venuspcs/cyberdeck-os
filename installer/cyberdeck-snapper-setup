#!/bin/sh
# Configure Snapper on a Btrfs root and enable grub-btrfs.
# Calamares runs this inside the target. The autoinstall path calls it too.
# DBus is not running during installation, so Snapper must use --no-dbus.
set -u

log() { echo "cyberdeck-snapper-setup: $*" >/dev/console; echo "cyberdeck-snapper-setup: $*"; }

if ! findmnt -n -o FSTYPE / | grep -q btrfs; then
	log "root is not btrfs, skipping"
	exit 0
fi

if [ -d /.snapshots ] && ! btrfs subvolume show /.snapshots >/dev/null 2>&1; then
	rm -rf /.snapshots
fi

if ! snapper --no-dbus -c root get-config >/dev/null 2>&1; then
	if ! snapper --no-dbus -c root create-config /; then
		log "create-config failed, writing the config directly"
		btrfs subvolume create /.snapshots || mkdir -p /.snapshots
		chmod 750 /.snapshots || true
		mkdir -p /etc/snapper/configs
		cp /usr/share/snapper/config-templates/default /etc/snapper/configs/root
		sed -i 's|^SUBVOLUME=.*|SUBVOLUME="/"|' /etc/snapper/configs/root
		sed -i 's|^TIMELINE_CREATE=.*|TIMELINE_CREATE="no"|' /etc/snapper/configs/root
		sed -i 's|^NUMBER_LIMIT=.*|NUMBER_LIMIT="10"|' /etc/snapper/configs/root
		sed -i 's|^NUMBER_LIMIT_IMPORTANT=.*|NUMBER_LIMIT_IMPORTANT="5"|' /etc/snapper/configs/root
		if [ -f /etc/default/snapper ] && grep -q '^SNAPPER_CONFIGS=' /etc/default/snapper; then
			sed -i 's|^SNAPPER_CONFIGS=.*|SNAPPER_CONFIGS="root"|' /etc/default/snapper
		else
			echo 'SNAPPER_CONFIGS="root"' >> /etc/default/snapper
		fi
	fi
fi

snapper --no-dbus -c root set-config NUMBER_LIMIT=10 NUMBER_LIMIT_IMPORTANT=5 TIMELINE_CREATE=no || true

if ! snapper --no-dbus -c root create --description "install" --cleanup-algorithm number; then
	log "could not create the install snapshot"
	exit 1
fi

systemctl enable grub-btrfsd.service || true
log "snapshot config ready"
snapper --no-dbus -c root list || true
exit 0
