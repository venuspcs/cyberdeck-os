---
componentName: cyberdeck
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,580px
windowPlacement: center

strings:
    productName: "Cyberdeck OS"
    shortProductName: "Cyberdeck OS"
    version: "pre-alpha"
    shortVersion: "pre-alpha"
    versionedName: "Cyberdeck OS pre-alpha"
    shortVersionedName: "Cyberdeck OS"
    bootloaderEntryName: "Cyberdeck OS"
    productUrl: "https://github.com/venuspcs/cyberdeck-os"
    supportUrl: "https://github.com/venuspcs/cyberdeck-os"
    knownIssuesUrl: "https://github.com/venuspcs/cyberdeck-os/issues"
    releaseNotesUrl: "https://github.com/venuspcs/cyberdeck-os"
    donateUrl: "https://cash.app/$richardcolbert72"

sidebar: widget
navigation: widget

# Temporary stand-in art copied from Debian branding. Cyberdeck artwork is not in the tree yet.
images:
    productLogo: "debian-logo.png"
    productIcon: "debian-logo.png"
    productWelcome: "welcome.png"

slideshow: "show.qml"

# Calamares 3.3 treats a missing style map as a fatal YAML error.
style:
    SidebarBackground: "#26475b"
    SidebarText: "#FFFFFF"
    SidebarTextCurrent: "#fbfbfb"
    SidebarBackgroundCurrent: "#265370"

slideshowAPI: 2
