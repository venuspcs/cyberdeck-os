#!/bin/sh
# Turn on the packaged NVIDIA driver when the hardware is present.
set -eu
if ! command -v lspci >/dev/null 2>&1; then
	exit 0
fi
if ! lspci -nn | grep -Ei 'VGA compatible controller|3D controller|Display controller' | grep -qi nvidia; then
	exit 0
fi
if dpkg -s nvidia-driver >/dev/null 2>&1; then
	if modprobe nvidia; then
		echo "NVIDIA GPU detected and the nvidia module loaded."
	else
		echo "NVIDIA GPU detected. The nvidia module did not load." >&2
	fi
else
	echo "NVIDIA GPU detected. nvidia-driver is not installed in this image." >&2
	echo "Install it with: apt-get install nvidia-driver" >&2
fi
exit 0
