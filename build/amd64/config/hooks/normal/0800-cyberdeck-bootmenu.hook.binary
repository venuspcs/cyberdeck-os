#!/bin/sh
# Live boot menus are generated with the Debian project name. Replace it.
# live-build runs this hook with the working directory already set to binary/.
set -eu
find . -type f \( -name '*.cfg' -o -name '*.svg' -o -name 'theme.txt' \) -print0 |
	xargs -0 -r sed -i \
		-e 's/Debian GNU\/Linux/Cyberdeck OS Beta 1 (Plow)/g' \
		-e 's/title-text: "Live Boot Menu with GRUB"/title-text: "Cyberdeck OS Beta 1 (Plow)"/' \
		-e 's/set gfxmode=800x600/set gfxmode=1024x768,auto/' \
		-e 's/set gfxpayload=keep/set gfxpayload=1024x768/' \
		-e 's/^timeout 0/timeout 150/'
if [ -f boot/grub/config.cfg ] && ! grep -q '^set timeout=' boot/grub/config.cfg; then
	printf '%s\n' 'set timeout=15' 'set timeout_style=menu' >> boot/grub/config.cfg
fi
# Keep the menu in the lower part of a 1024x768 screen, under the title.
find . -name stdmenu.cfg -print0 | xargs -0 -r sed -i 's/^menu vshift .*/menu vshift 16/'
