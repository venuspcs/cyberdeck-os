#!/bin/sh
# Configure the Cyberdeck OS AMD64 live-build tree.
# CYBERDECK_PROFILE=ci   (default) plasma, Calamares, snapper, docker, firewall
# CYBERDECK_PROFILE=full ci packages plus the rest of the spec package set

set -eu

ROOT="$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)"
HERE="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
cd "${HERE}"

PROFILE="${CYBERDECK_PROFILE:-ci}"
case "${PROFILE}" in
	ci|full) ;;
	*)
		echo "Unknown CYBERDECK_PROFILE=${PROFILE} (use ci or full)" >&2
		exit 1
		;;
esac

mkdir -p config/package-lists \
	config/includes.chroot_after_packages/etc/cyberdeck \
	config/includes.chroot_after_packages/usr/sbin \
	config/includes.chroot_after_packages/usr/bin \
	config/includes.chroot_after_packages/usr/lib/live/config \
	config/includes.chroot_after_packages/usr/lib/cyberdeck \
	config/includes.chroot_after_packages/usr/share/cyberdeck \
	config/includes.chroot_after_packages/usr/share/applications \
	config/includes.chroot_after_packages/etc/xdg/autostart \
	config/includes.chroot_after_packages/etc/calamares/branding/cyberdeck \
	config/includes.chroot_after_packages/etc/calamares/modules \
	config/includes.chroot_after_packages/etc/apt/apt.conf.d \
	config/includes.chroot_after_packages/etc/apt/sources.list.d \
	config/includes.chroot_after_packages/etc/apt/preferences.d \
	config/includes.chroot_after_packages/etc/systemd/system \
	config/includes.chroot_after_packages/etc/systemd/system/timers.target.wants \
	config/includes.chroot_after_packages/etc/systemd/system/multi-user.target.wants \
	config/includes.chroot_after_packages/etc/NetworkManager/dispatcher.d \
	config/includes.chroot_after_packages/etc/meshtasticd/config.d \
	config/includes.chroot_after_packages/etc/cyberdeck/nomad-gate \
	config/includes.chroot_after_packages/etc/pam.d \
	config/includes.chroot_after_packages/etc/security \
	config/includes.chroot_after_packages/etc/fail2ban/jail.d \
	config/includes.chroot_after_packages/etc/fail2ban/filter.d \
	config/includes.chroot_after_packages/etc/systemd/system/docker.service.d \
	config/includes.chroot_after_packages/etc/tmpfiles.d \
	config/includes.chroot_after_packages/usr/lib/sysusers.d \
	config/includes.chroot_after_packages/etc/polkit-1/rules.d \
	config/includes.chroot_after_packages/usr/share/doc/cyberdeck-os \
	config/archives \
	config/preseed \
	config/hooks/normal

printf '%s\n' "${PROFILE}" > config/includes.chroot_after_packages/etc/cyberdeck/profile

cp "${ROOT}/packages/amd64/ci.list.chroot" config/package-lists/ci.list.chroot
rm -f config/archives/meshtastic.list.chroot config/archives/meshtastic.key.chroot
rm -f config/includes.chroot_after_packages/etc/apt/sources.list.d/meshtastic.list
rm -f config/includes.chroot_after_packages/etc/apt/trusted.gpg.d/meshtastic-obs.asc
if [ "${PROFILE}" = "full" ]; then
	cp "${ROOT}/packages/amd64/full.list.chroot" config/package-lists/full.list.chroot
	cp "${ROOT}/packages/amd64/alpha3.list.chroot" config/package-lists/alpha3.list.chroot
	cp "${ROOT}/installer/meshtastic.list" config/archives/meshtastic.list.chroot
	cp "${ROOT}/installer/meshtastic-obs.key" config/archives/meshtastic.key.chroot
	mkdir -p config/includes.chroot_after_packages/etc/apt/trusted.gpg.d
	cp "${ROOT}/installer/meshtastic.list" config/includes.chroot_after_packages/etc/apt/sources.list.d/meshtastic.list
	cp "${ROOT}/installer/meshtastic-obs.key" config/includes.chroot_after_packages/etc/apt/trusted.gpg.d/meshtastic-obs.asc
else
	rm -f config/package-lists/full.list.chroot config/package-lists/alpha3.list.chroot
fi

# Installer, first-boot, and image overlays. Source of truth is the repo
# directories; this copy is what live-build puts in the squashfs.
cp "${ROOT}/installer/cyberdeck-autoinstall" config/includes.chroot_after_packages/usr/sbin/cyberdeck-autoinstall
cp "${ROOT}/installer/cyberdeck-snapper-setup" config/includes.chroot_after_packages/usr/sbin/cyberdeck-snapper-setup
cp "${ROOT}/installer/cyberdeck-snap-pre" config/includes.chroot_after_packages/usr/sbin/cyberdeck-snap-pre
cp "${ROOT}/installer/cyberdeck-nvidia-enable" config/includes.chroot_after_packages/usr/sbin/cyberdeck-nvidia-enable
cp "${ROOT}/firstboot/cyberdeck-nomad-setup" config/includes.chroot_after_packages/usr/sbin/cyberdeck-nomad-setup
cp "${ROOT}/firstboot/cyberdeck-welcome" config/includes.chroot_after_packages/usr/bin/cyberdeck-welcome
cp "${ROOT}/firstboot/cyberdeck-control-panel" config/includes.chroot_after_packages/usr/bin/cyberdeck-control-panel
cp "${ROOT}/firstboot/nomad-compose.yml.in" config/includes.chroot_after_packages/usr/share/cyberdeck/nomad-compose.yml.in
cp "${ROOT}/firstboot/live-sddm-autologin" config/includes.chroot_after_packages/usr/lib/live/config/9990-cyberdeck-sddm
cp "${ROOT}/installer/calamares/settings.conf" config/includes.chroot_after_packages/etc/calamares/settings.conf
cp "${ROOT}/installer/calamares/modules/"*.conf config/includes.chroot_after_packages/etc/calamares/modules/
cp "${ROOT}/installer/calamares/branding.desc" config/includes.chroot_after_packages/etc/calamares/branding/cyberdeck/branding.desc
cp "${ROOT}/installer/install-cyberdeck-os.desktop" config/includes.chroot_after_packages/usr/share/applications/calamares-install-debian.desktop
install -m 0755 "${ROOT}/installer/calamares-install-debian" config/includes.chroot_after_packages/usr/bin/calamares-install-debian
cp "${ROOT}/installer/49-cyberdeck-calamares.rules" config/includes.chroot_after_packages/etc/polkit-1/rules.d/49-cyberdeck-calamares.rules
cp "${ROOT}/firstboot/cyberdeck-welcome.desktop" config/includes.chroot_after_packages/usr/share/applications/cyberdeck-welcome.desktop
cp "${ROOT}/firstboot/cyberdeck-control-panel.desktop" config/includes.chroot_after_packages/usr/share/applications/cyberdeck-control-panel.desktop
cp "${ROOT}/firstboot/cyberdeck-welcome-autostart.desktop" config/includes.chroot_after_packages/etc/xdg/autostart/cyberdeck-welcome.desktop
cp "${ROOT}/installer/80cyberdeck-snapper" config/includes.chroot_after_packages/etc/apt/apt.conf.d/80cyberdeck-snapper
cp "${ROOT}/installer/cyberdeck-backports.list" config/includes.chroot_after_packages/etc/apt/sources.list.d/cyberdeck-backports.list
cp "${ROOT}/installer/cyberdeck-kernel.pref" config/includes.chroot_after_packages/etc/apt/preferences.d/cyberdeck-kernel
cp "${ROOT}/installer/cyberdeck-autoinstall.service" config/includes.chroot_after_packages/etc/systemd/system/cyberdeck-autoinstall.service
cp "${ROOT}/installer/cyberdeck-nvidia.service" config/includes.chroot_after_packages/etc/systemd/system/cyberdeck-nvidia.service
cp "${ROOT}/branding/TODO-themes.txt" config/includes.chroot_after_packages/usr/share/doc/cyberdeck-os/TODO-themes.txt
cp "${ROOT}/dashboard/TODO-dashboard.txt" config/includes.chroot_after_packages/usr/share/doc/cyberdeck-os/TODO-dashboard.txt
rm -rf config/includes.chroot_after_packages/usr/share/cyberdeck/branding
mkdir -p config/includes.chroot_after_packages/usr/share/cyberdeck/branding
cp -a "${ROOT}/branding/image/." config/includes.chroot_after_packages/usr/share/cyberdeck/branding/
cp "${ROOT}/installer/cyberdeck-apply-image" config/includes.chroot_after_packages/usr/sbin/cyberdeck-apply-image
cp "${ROOT}/installer/cyberdeck-chrome-install" config/includes.chroot_after_packages/usr/sbin/cyberdeck-chrome-install
cp "${ROOT}/firstboot/cyberdeck-theme" config/includes.chroot_after_packages/usr/bin/cyberdeck-theme
cp "${ROOT}/firstboot/cyberdeck-theme-daemon" config/includes.chroot_after_packages/usr/bin/cyberdeck-theme-daemon
cp "${ROOT}/firstboot/cyberdeck-support" config/includes.chroot_after_packages/usr/bin/cyberdeck-support
cp "${ROOT}/firstboot/cyberdeck-support.desktop" config/includes.chroot_after_packages/usr/share/applications/cyberdeck-support.desktop
cp "${ROOT}/firstboot/cyberdeck-extras" config/includes.chroot_after_packages/usr/sbin/cyberdeck-extras
cp "${ROOT}/firstboot/cyberdeck-extras.desktop" config/includes.chroot_after_packages/usr/share/applications/cyberdeck-extras.desktop
cp "${ROOT}/firstboot/cyberdeck-conky.desktop" config/includes.chroot_after_packages/etc/xdg/autostart/cyberdeck-conky.desktop
cp "${ROOT}/installer/cyberdeck-lan-firewall" config/includes.chroot_after_packages/usr/sbin/cyberdeck-lan-firewall
cp "${ROOT}/firstboot/nomad-supply.yml.in" config/includes.chroot_after_packages/usr/share/cyberdeck/nomad-supply.yml.in
cp "${ROOT}/firstboot/cyberdeck-verbose.sh" config/includes.chroot_after_packages/usr/lib/cyberdeck/verbose.sh
cp "${ROOT}/firstboot/cyberdeck-conky-toggle" config/includes.chroot_after_packages/usr/bin/cyberdeck-conky-toggle
cp "${ROOT}/firstboot/cyberdeck-conky-toggle.desktop" config/includes.chroot_after_packages/usr/share/applications/cyberdeck-conky-toggle.desktop
cp "${ROOT}/installer/cyberdeck-install-system" config/includes.chroot_after_packages/usr/bin/cyberdeck-install-system
cp "${ROOT}/firstboot/cyberdeck-nomad-launch" config/includes.chroot_after_packages/usr/bin/cyberdeck-nomad-launch
cp "${ROOT}/firstboot/cyberdeck-multiwan" config/includes.chroot_after_packages/usr/sbin/cyberdeck-multiwan
cp "${ROOT}/firstboot/meshtasticd-cyberdeck-web.yaml" config/includes.chroot_after_packages/etc/meshtasticd/config.d/cyberdeck-web.yaml
cp "${ROOT}/firstboot/cyberdeck-nomad-gate" config/includes.chroot_after_packages/usr/sbin/cyberdeck-nomad-gate
cp "${ROOT}/firstboot/cyberdeck-nomad-gate.conf" config/includes.chroot_after_packages/etc/cyberdeck/nomad-gate/nginx.conf
cp "${ROOT}/firstboot/cyberdeck-nomad.pam" config/includes.chroot_after_packages/etc/pam.d/cyberdeck-nomad
cp "${ROOT}/firstboot/access-cyberdeck-nomad.conf" config/includes.chroot_after_packages/etc/security/access-cyberdeck-nomad.conf
cp "${ROOT}/firstboot/cyberdeck-nomad-gate.service" config/includes.chroot_after_packages/etc/systemd/system/cyberdeck-nomad-gate.service
cp "${ROOT}/firstboot/cyberdeck-nomad-bind.service" config/includes.chroot_after_packages/etc/systemd/system/cyberdeck-nomad-bind.service
cp "${ROOT}/firstboot/cyberdeck-nomad-bind.path" config/includes.chroot_after_packages/etc/systemd/system/cyberdeck-nomad-bind.path
cp "${ROOT}/firstboot/cyberdeck-nomad-gate.filter" config/includes.chroot_after_packages/etc/fail2ban/filter.d/cyberdeck-nomad-gate.conf
cp "${ROOT}/firstboot/cyberdeck-nomad-gate.jail" config/includes.chroot_after_packages/etc/fail2ban/jail.d/cyberdeck-nomad-gate.conf
cp "${ROOT}/branding/image/docker-cyberdeck-firewall.conf" config/includes.chroot_after_packages/etc/systemd/system/docker.service.d/cyberdeck-firewall.conf
cp "${ROOT}/firstboot/cyberdeck-nomad-gate.tmpfiles" config/includes.chroot_after_packages/etc/tmpfiles.d/cyberdeck-nomad-gate.conf
cp "${ROOT}/firstboot/cyberdeck.sysusers" config/includes.chroot_after_packages/usr/lib/sysusers.d/cyberdeck.conf
ln -sfn ../cyberdeck-nomad-bind.path config/includes.chroot_after_packages/etc/systemd/system/multi-user.target.wants/cyberdeck-nomad-bind.path
ln -sfn ../cyberdeck-nomad-gate.service config/includes.chroot_after_packages/etc/systemd/system/multi-user.target.wants/cyberdeck-nomad-gate.service
cp "${ROOT}/firstboot/90-cyberdeck-multiwan" config/includes.chroot_after_packages/etc/NetworkManager/dispatcher.d/90-cyberdeck-multiwan
cp "${ROOT}/firstboot/cyberdeck-multiwan.service" config/includes.chroot_after_packages/etc/systemd/system/cyberdeck-multiwan.service
cp "${ROOT}/firstboot/cyberdeck-multiwan.timer" config/includes.chroot_after_packages/etc/systemd/system/cyberdeck-multiwan.timer
ln -sfn ../cyberdeck-multiwan.timer config/includes.chroot_after_packages/etc/systemd/system/timers.target.wants/cyberdeck-multiwan.timer
cp "${ROOT}/firstboot/cyberdeck-theme.desktop" config/includes.chroot_after_packages/etc/xdg/autostart/cyberdeck-theme.desktop
chmod 755 config/includes.chroot_after_packages/usr/sbin/* \
	config/includes.chroot_after_packages/usr/bin/* \
	config/includes.chroot_after_packages/usr/lib/live/config/9990-cyberdeck-sddm \
	config/includes.chroot_after_packages/etc/NetworkManager/dispatcher.d/90-cyberdeck-multiwan

cp "${ROOT}/installer/cyberdeck-backports.list" config/archives/backports.list.chroot
cp "${ROOT}/installer/cyberdeck-kernel.pref" config/archives/backports.pref.chroot
cp "${ROOT}/installer/preseed.cfg" config/preseed/cyberdeck.cfg.chroot

lb config noauto \
	--mode debian \
	--distribution trixie \
	--parent-distribution trixie \
	--archive-areas "main contrib non-free-firmware non-free" \
	--parent-archive-areas "main contrib non-free-firmware non-free" \
	--mirror-bootstrap "http://deb.debian.org/debian" \
	--mirror-chroot "http://deb.debian.org/debian" \
	--mirror-binary "http://deb.debian.org/debian" \
	--mirror-chroot-security "http://deb.debian.org/debian-security" \
	--mirror-binary-security "http://deb.debian.org/debian-security" \
	--security true \
	--updates true \
	--binary-images iso-hybrid \
	--bootloaders "syslinux grub-efi" \
	--debian-installer none \
	--memtest none \
	--win32-loader false \
	--checksums sha256 \
	--compression gzip \
	--apt-recommends true \
	--firmware-chroot false \
	--firmware-binary false \
	--zsync false \
	--source false \
	--linux-packages "linux-image" \
	--linux-flavours amd64 \
	--iso-application "Cyberdeck OS" \
	--iso-preparer "Cyberdeck OS live-build" \
	--iso-publisher "Richard Colbert" \
	--iso-volume "CYBERDECKOS" \
	--image-name "cyberdeck-os-amd64" \
	--bootappend-live "boot=live components username=cyberdeck hostname=cyberdeck console=tty0 console=ttyS0,115200" \
	--bootappend-live-failsafe "boot=live components memtest noapic noapm nodma nomce nosplash username=cyberdeck hostname=cyberdeck console=tty0 console=ttyS0,115200" \
	"${@}"

mkdir -p config/bootloaders/grub-pc/live-theme
cp "${ROOT}/branding/grub-theme.txt" config/bootloaders/grub-pc/live-theme/theme.txt
cp "${ROOT}/branding/splash.svg" config/bootloaders/splash.svg
# 1024x768 and a 15 second menu, on the live ISO.
if [ -f config/bootloaders/grub-pc/config.cfg ]; then
	sed -i \
		-e 's/set gfxmode=800x600/set gfxmode=1024x768,auto/' \
		-e 's/set gfxpayload=keep/set gfxpayload=1024x768/' \
		config/bootloaders/grub-pc/config.cfg
	grep -q '^set timeout=' config/bootloaders/grub-pc/config.cfg || printf '%s\n' 'set timeout=15' 'set timeout_style=menu' >> config/bootloaders/grub-pc/config.cfg
fi
for cfg in config/bootloaders/isolinux/isolinux.cfg config/bootloaders/syslinux/syslinux.cfg; do
	if [ -f "$cfg" ]; then
		sed -i 's/^timeout 0/timeout 150/' "$cfg"
		grep -q 'menu resolution' "$cfg" || printf '%s\n' 'menu resolution 1024 768' >> "$cfg"
	fi
done
find config/bootloaders -name stdmenu.cfg -print0 | xargs -0 -r sed -i 's/^menu vshift .*/menu vshift 16/'

echo "Cyberdeck OS live-build config ready (profile ${PROFILE})."
