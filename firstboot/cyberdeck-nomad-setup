#!/bin/bash
# First-boot Project Nomad installer.
# Picks the /library drive, mounts it by UUID, holds Docker until that
# mount exists, writes the Nomad compose file, and offers ROCm or CUDA.
set -eu

if [ ! -t 1 ] && command -v konsole >/dev/null 2>&1; then
	exec konsole --hold -e "$0" "$@"
fi
if [ "$(id -u)" -ne 0 ]; then
	echo "Type your password. Nothing will show as you type."
	exec sudo /usr/sbin/cyberdeck-nomad-setup "$@"
fi
LOG=/var/log/cyberdeck-nomad-setup.log
mkdir -p /var/log
exec > >(tee -a "$LOG") 2>&1
echo "======== Project Nomad Setup ========"
echo "Log: $LOG"

force=0
if [ "${1:-}" = "--force" ] || [ "${CYBERDECK_SETUP_FORCE:-}" = 1 ]; then
	force=1
fi

if grep -q 'cyberdeck.skip-nomad' /proc/cmdline 2>/dev/null; then
	echo "DONE: Nomad setup skipped by the boot command."
	echo "Press Enter to close."
	read -r _ || true
	exit 0
fi

if [ "$force" != 1 ] && [ -e /var/lib/cyberdeck/nomad.done ]; then
	echo "DONE: Project Nomad Setup already finished."
	echo "Log: $LOG"
	echo "Press Enter to close."
	read -r _ || true
	exit 0
fi

# On a live boot, leave the wizard to the menu. The autostart entry
# calls this script; exiting here keeps the live desktop usable.
if [ "$force" != 1 ] && [ -d /run/live/medium ]; then
	exit 0
fi

# A graphical launch without a terminal cannot show the sudo or whiptail
# prompts. The desktop entry opens konsole itself. If we are already in
# a terminal, stay there.
if [ ! -t 0 ] && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
	if command -v konsole >/dev/null 2>&1; then
		exec konsole -e sudo /usr/sbin/cyberdeck-nomad-setup --force
	fi
fi

ask_yes() {
	whiptail --title "Cyberdeck OS" --yesno "$1" 12 70
}

disk_backing() {
	src="$(findmnt -no SOURCE "$1" 2>/dev/null || true)"
	[ -n "${src}" ] || return 0
	pk="$(lsblk -no PKNAME "${src}" 2>/dev/null | head -1 || true)"
	if [ -n "${pk}" ]; then
		printf '/dev/%s\n' "${pk}"
	else
		printf '%s\n' "${src}"
	fi
}

is_system_disk() {
	dev="$1"
	pk="$(lsblk -no PKNAME "${dev}" 2>/dev/null | head -1 || true)"
	if [ -n "${pk}" ]; then
		whole="/dev/${pk}"
	else
		whole="${dev}"
	fi
	for mountpoint in / /boot /boot/efi /run/live/medium; do
		sys="$(disk_backing "${mountpoint}")"
		[ -n "${sys}" ] || continue
		if [ "${whole}" = "${sys}" ] || [ "${dev}" = "${sys}" ]; then
			return 0
		fi
	done
	return 1
}

choose_disk() {
	set -- boot "Folder on the boot drive"
	# Never offer the disk that holds the running system or the live medium.
	while IFS= read -r line; do
		name="$(printf '%s\n' "${line}" | sed -n 's/.*NAME="\([^"]*\)".*/\1/p')"
		size="$(printf '%s\n' "${line}" | sed -n 's/.*SIZE="\([^"]*\)".*/\1/p')"
		fstype="$(printf '%s\n' "${line}" | sed -n 's/.*FSTYPE="\([^"]*\)".*/\1/p')"
		typ="$(printf '%s\n' "${line}" | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p')"
		[ -n "${name}" ] || continue
		case "${name}" in
			/dev/sr*|/dev/fd*|/dev/zram*|/dev/loop*) continue ;;
		esac
		if is_system_disk "${name}"; then
			continue
		fi
		case "${typ}" in
			disk)
				if [ -n "${fstype}" ]; then
					label="${size} ${fstype}"
				else
					label="${size} empty disk"
				fi
				;;
			part)
				[ -n "${fstype}" ] || continue
				label="${size} ${fstype} partition"
				;;
			*) continue ;;
		esac
		set -- "$@" "${name}" "${label}"
	done <<EOF
$(lsblk -P -p -o NAME,SIZE,FSTYPE,TYPE)
EOF
	whiptail --title "Project Nomad" --menu "Where should /library live?" 20 72 8 "$@" 3>&1 1>&2 2>&3
}

mkdir -p /var/lib/cyberdeck /etc/cyberdeck /library

choice="$(choose_disk || true)"
if [ -z "${choice}" ]; then
	echo "No drive chosen."
	exit 0
fi

if [ "${choice}" = "boot" ]; then
	mkdir -p /library
	# /library is a directory on the root filesystem. Docker's
	# RequiresMountsFor=/library is satisfied with the root mount.
else
	dev="${choice}"
	if [ ! -b "${dev}" ]; then
		echo "Not a disk: ${dev}" >&2
		exit 1
	fi
	action="$(whiptail --title "Project Nomad" --menu "Disk ${dev}" 15 70 4 \
		format "Format it as Btrfs and use it for /library" \
		asis "Use the filesystem that is already on it" \
		3>&1 1>&2 2>&3)" || exit 0
	if [ "${action}" = "format" ]; then
		mkfs.btrfs -f -L library "${dev}"
		fstype=btrfs
	else
		fstype="$(blkid -s TYPE -o value "${dev}" || true)"
		if [ -z "${fstype}" ]; then
			echo "No filesystem on ${dev}. Format it, or pick another disk." >&2
			exit 1
		fi
	fi
	uuid="$(blkid -s UUID -o value "${dev}")"
	grep -v '[[:space:]]/library[[:space:]]' /etc/fstab > /etc/fstab.cyberdeck || true
	mv /etc/fstab.cyberdeck /etc/fstab
	printf 'UUID=%s /library %s defaults,nofail,x-systemd.device-timeout=30 0 2\n' \
		"${uuid}" "${fstype}" >> /etc/fstab
	mkdir -p /library
	mount /library || mount "${dev}" /library
fi

mkdir -p /etc/systemd/system/docker.service.d
cat > /etc/systemd/system/docker.service.d/library.conf <<'EOF'
[Unit]
RequiresMountsFor=/library
After=local-fs.target
EOF
systemctl daemon-reload || true

mkdir -p /library/nomad/storage/qdrant /library/nomad/storage/zim /library/nomad/storage/kolibri 	/library/nomad/storage/notes /library/nomad/storage/stirling /library/nomad/storage/filebrowser 	/library/nomad/storage/calibre /library/nomad/storage/books /library/nomad/storage/homebox 	/library/nomad/storage/jellyfin /library/nomad/storage/media 	/library/nomad/mysql /library/nomad/redis /library/ollama /library/open-webui
chmod 777 /library/nomad/storage/qdrant
# One physical line. A wrapped command gets pasted as several lines in Konsole.
mysql_fix_line='sudo mv /library/nomad/mysql /library/nomad/mysql.bak-$(date +%Y%m%d%H%M%S) && sudo /usr/sbin/cyberdeck-nomad-setup --force'
mysql_initialized=0
if [ -f /library/nomad/mysql/ibdata1 ] || [ -f /library/nomad/mysql/auto.cnf ] || [ -d /library/nomad/mysql/mysql ]; then
	mysql_initialized=1
fi
cred=/library/nomad/credentials
mysql_declined=0
if [ -f "$cred" ]; then
	app_key=""
	db_pass=""
	root_pass=""
	while IFS='=' read -r key value; do
		case "$key" in
			NOMAD_APP_KEY) app_key="$value" ;;
			NOMAD_DB_PASSWORD) db_pass="$value" ;;
			NOMAD_MYSQL_ROOT) root_pass="$value" ;;
		esac
	done < "$cred"
	case "${app_key}:${db_pass}:${root_pass}" in
		*[!0123456789abcdef:]*)
			echo "ERROR: $cred is not a saved Nomad password file. Refusing to use it." >&2
			exit 1
			;;
		:*|*::*|*:)
			echo "ERROR: $cred is missing a saved Nomad password. Refusing to use it." >&2
			exit 1
			;;
	esac
	echo "Reusing saved Nomad database credentials from $cred"
else
	app_key="$(openssl rand -hex 24)"
	db_pass="$(openssl rand -hex 18)"
	root_pass="$(openssl rand -hex 18)"
	if [ "$mysql_initialized" = 1 ]; then
		echo "MySQL data already exists at /library/nomad/mysql, and no saved password was found."
		echo "nomad_admin will log: Access denied for user 'nomad_user' and keep restarting."
		echo "One-line fix: $mysql_fix_line"
		if ask_yes "Move the old MySQL data aside now and create a new database?"; then
			stamp="$(date +%Y%m%d%H%M%S)"
			mv /library/nomad/mysql "/library/nomad/mysql.bak-${stamp}"
			mkdir -p /library/nomad/mysql
			echo "Old database is /library/nomad/mysql.bak-${stamp}"
		else
			mysql_declined=1
			echo "Leaving the old database in place."
			echo "One-line fix: $mysql_fix_line"
		fi
	fi
	umask 077
	cat > "$cred" <<EOF
NOMAD_APP_KEY=${app_key}
NOMAD_DB_PASSWORD=${db_pass}
NOMAD_MYSQL_ROOT=${root_pass}
EOF
	chmod 600 "$cred"
fi
sed -e "s/__APP_KEY__/${app_key}/" \
	-e "s/__DB_PASSWORD__/${db_pass}/" \
	-e "s/__MYSQL_ROOT__/${root_pass}/" \
	/usr/share/cyberdeck/nomad-compose.yml.in > /library/nomad/compose.yml
cp /usr/share/cyberdeck/nomad-supply.yml.in /library/nomad/supply.yml
chmod 600 /library/nomad/compose.yml /library/nomad/supply.yml
if [ -x /usr/sbin/cyberdeck-nomad-gate ]; then
	/usr/sbin/cyberdeck-nomad-gate apply-bind || true
fi

display_pci() {
	lspci -nn 2>/dev/null | grep -Ei 'VGA compatible controller|3D controller|Display controller' || true
}

if display_pci | grep -qi nvidia; then
	echo "-------- NVIDIA --------"
	echo "An NVIDIA GPU is present."
	ver=$(apt-cache policy nvidia-driver | awk '/Candidate:/{print $2; exit}')
	echo "Debian nvidia-driver candidate: ${ver:-none}"
	case "$ver" in
		550.*|"")
			echo "ERROR: driver ${ver:-550} does not build on kernel 7.3. Not installing it."
			echo "NVIDIA driver was not installed." | tee /var/lib/cyberdeck/gpu.txt
			;;
		*)
			echo "Installing nvidia-driver $ver"
			apt-get -o DPkg::Lock::Timeout=600 update
			apt-get -o DPkg::Lock::Timeout=600 install -y nvidia-driver || echo "ERROR: nvidia-driver install failed"
			;;
	esac
fi
if display_pci | grep -Eqi 'amd/ati|advanced micro devices'; then
	if ask_yes "An AMD display device is present. Install the Debian ROCm packages that exist in this release (rocminfo) and keep Ollama ready for a GPU?"; then
		apt-get -o DPkg::Lock::Timeout=600 update
		if apt-get -o DPkg::Lock::Timeout=600 install -y rocminfo; then
			echo "Installed rocminfo. A full ROCm stack is not in the Debian 13 image; Ollama stays on the CPU build until that stack is installed." | tee /var/lib/cyberdeck/gpu.txt
		else
			echo "rocminfo is not installable from the configured apt sources." | tee /var/lib/cyberdeck/gpu.txt
		fi
	fi
fi

cat > /etc/cyberdeck/ollama.env <<'EOF'
OLLAMA_HOST=127.0.0.1:11434
EOF

if ask_yes "Pull and start Nomad, Open WebUI, and Ollama now? This needs a network. Nomad admin is port 8080, Open WebUI is port 3000, Ollama listens on 127.0.0.1:11434."; then
	systemctl enable --now docker.service || true
	if docker compose version >/dev/null 2>&1; then
		compose() { docker compose "$@"; }
	elif command -v docker-compose >/dev/null 2>&1; then
		compose() { docker-compose "$@"; }
	else
		echo "Docker Compose is not installed." >&2
		exit 1
	fi
	compose -f /library/nomad/compose.yml up -d
	warn_text_model() {
		case "$1" in
			*-text-*)
				echo "Refusing $1. Tags with -text- are base models and answer with gibberish. Use llama3.2:3b." >&2
				return 1
				;;
		esac
		return 0
	}
	if warn_text_model "llama3.2:3b"; then
		docker exec nomad_ollama ollama pull llama3.2:3b || echo "Could not pull llama3.2:3b yet." >&2
		docker exec nomad_ollama ollama show llama3.2:3b || true
	fi
	echo "-------- Supply Depot --------"
	echo "Pulling each image on its own. One failure does not cancel the rest."
	supply=/library/nomad/supply.yml
	supply_failed=""
	services="$(compose -f "$supply" config --services || true)"
	if [ -z "$services" ]; then
		supply_failed=" compose-config"
		echo "ERROR: could not read the Supply Depot service list."
	fi
	for svc in $services; do
		echo "-------- pull $svc --------"
		ok=0
		try=1
		while [ "$try" -le 3 ]; do
			if compose -f "$supply" pull "$svc"; then
				ok=1
				break
			fi
			echo "Pull of $svc failed (try $try of 3)."
			try=$((try + 1))
			sleep 5
		done
		if [ "$ok" != 1 ]; then
			supply_failed="$supply_failed $svc"
			continue
		fi
		echo "-------- start $svc --------"
		if ! compose -f "$supply" up -d --no-deps "$svc"; then
			echo "Start of $svc failed."
			supply_failed="$supply_failed $svc"
		fi
	done
	echo
	if [ -n "$supply_failed" ]; then
		echo "ERROR: Supply Depot apps that failed:$supply_failed"
	else
		echo "DONE: every Supply Depot app started."
	fi
	echo "Vaultwarden is not installed."
	if curl -fsS --max-time 20 http://127.0.0.1:6333/healthz >/dev/null; then
		echo "Qdrant is answering on 127.0.0.1:6333."
	else
		echo "Qdrant did not answer /healthz yet." >&2
	fi
	echo "-------- Nomad admin --------"
	echo "Waiting up to 3 minutes for http://127.0.0.1:8080"
	admin_ready=0
	i=0
	while [ "$i" -lt 36 ]; do
		code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:8080/ || true)"
		if [ -n "$code" ] && [ "$code" != "000" ]; then
			echo "Nomad admin answered HTTP $code"
			admin_ready=1
			break
		fi
		if docker logs --since 3m nomad_admin 2>&1 | grep -q "Access denied for user 'nomad_user'"; then
			echo "nomad_admin is running, but MySQL rejected nomad_user."
			break
		fi
		i=$((i + 1))
		sleep 5
	done
	if docker logs --since 3m nomad_admin 2>&1 | grep -q "Access denied for user 'nomad_user'"; then
		echo "The MySQL data in /library/nomad/mysql was created with a different password."
		echo "One-line fix: $mysql_fix_line"
		if [ "$mysql_declined" != 1 ] && ask_yes "Move the old MySQL data aside now and create a new database?"; then
			stamp="$(date +%Y%m%d%H%M%S)"
			compose -f /library/nomad/compose.yml stop admin mysql || true
			docker rm -f nomad_admin nomad_mysql || true
			mv /library/nomad/mysql "/library/nomad/mysql.bak-${stamp}"
			mkdir -p /library/nomad/mysql
			echo "Old database is /library/nomad/mysql.bak-${stamp}"
			compose -f /library/nomad/compose.yml up -d
			admin_ready=0
			i=0
			while [ "$i" -lt 36 ]; do
				code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:8080/ || true)"
				if [ -n "$code" ] && [ "$code" != "000" ]; then
					echo "Nomad admin answered HTTP $code"
					admin_ready=1
					break
				fi
				i=$((i + 1))
				sleep 5
			done
		fi
	fi
	if [ "$admin_ready" = 1 ]; then
		echo "-------- register llama3.2:3b --------"
		curl -fsS --max-time 30 -H 'Content-Type: application/json' \
			-d '{"model":"llama3.2:3b"}' http://127.0.0.1:8080/api/ollama/models \
			|| echo "Nomad admin is up. The model registration call failed. Retry it from the Nomad page."
	else
		echo "ERROR: Nomad admin did not become ready on 127.0.0.1:8080 within 3 minutes."
	fi
fi

date -Is > /var/lib/cyberdeck/nomad.done
echo "Nomad installer finished. Compose file: /library/nomad/compose.yml"
