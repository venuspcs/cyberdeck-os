#!/bin/sh
# Apply Daybreak or Nightwatch from the clock in /etc/cyberdeck/theme.conf.
set -u
CONF=/etc/cyberdeck/theme.conf
DAY_START=06:30
NIGHT_START=18:30
if [ -f "$CONF" ]; then
	# shellcheck disable=SC1090
	. "$CONF"
fi
to_min() {
	printf '%s\n' "$1" | awk -F: '{ print ($1 * 60) + $2 }'
}
now=$(date +%H:%M)
now_m=$(to_min "$now")
day_m=$(to_min "$DAY_START")
night_m=$(to_min "$NIGHT_START")
if [ "$now_m" -ge "$day_m" ] && [ "$now_m" -lt "$night_m" ]; then
	wall=/usr/share/wallpapers/cyberdeck/daybreak.png
	scheme=BreezeLight
else
	wall=/usr/share/wallpapers/cyberdeck/nightwatch.png
	scheme=BreezeDark
fi
if [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
	plasma-apply-wallpaperimage "$wall" >/dev/null 2>&1 || true
	plasma-apply-colorscheme "$scheme" >/dev/null 2>&1 || true
	mkdir -p "${HOME}/.config"
	cat > "${HOME}/.config/kscreenlockerrc" <<EOF
[Greeter]
WallpaperPlugin=org.kde.image

[Greeter][Wallpaper][org.kde.image][General]
Image=$wall
FillMode=2
EOF
fi
