#!/bin/bash
# Per-flow multi-WAN. New connections are spread across healthy uplinks.
# One download stays on one link. This is not single-stream bonding.
set -u

CONF=/etc/cyberdeck/multiwan.conf
METRIC=50
LOCK=/run/cyberdeck-multiwan.lock

log() {
	logger -t cyberdeck-multiwan -- "$*" 2>/dev/null || true
	if [ -t 1 ]; then
		printf '%s\n' "$*"
	fi
}

load_conf() {
	ENABLED=yes
	CHECK_HOSTS="1.1.1.1 8.8.8.8"
	[ -f "$CONF" ] || return 0
	while IFS='=' read -r key value; do
		case "$key" in
			\#*|"") ;;
			ENABLED) ENABLED="$value" ;;
			CHECK_HOSTS) CHECK_HOSTS="$value" ;;
		esac
	done < "$CONF"
}

set_enabled() {
	want="$1"
	mkdir -p /etc/cyberdeck
	if [ -f "$CONF" ]; then
		if grep -q '^ENABLED=' "$CONF"; then
			sed -i "s/^ENABLED=.*/ENABLED=${want}/" "$CONF"
		else
			printf 'ENABLED=%s\n' "$want" >> "$CONF"
		fi
	else
		printf '%s\n' "ENABLED=${want}" 'CHECK_HOSTS="1.1.1.1 8.8.8.8"' > "$CONF"
	fi
	chmod 644 "$CONF"
}

clear_route() {
	ip route del default metric "$METRIC" 2>/dev/null || true
}

vpn_owns_default() {
	command -v nmcli >/dev/null 2>&1 || return 1
	nmcli -t -f TYPE,NAME connection show --active 2>/dev/null | while IFS=: read -r type name; do
		case "$type" in
			vpn|wireguard|tun) ;;
			*) continue ;;
		esac
		never="$(nmcli -g ipv4.never-default connection show "$name" 2>/dev/null || true)"
		if [ "$never" != "yes" ]; then
			echo yes
			break
		fi
	done | grep -q yes
}

# Print "dev gateway address" for each connected non-VPN uplink.
list_uplinks() {
	command -v nmcli >/dev/null 2>&1 || return 0
	nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | while IFS=: read -r dev type state; do
		[ -n "$dev" ] && [ "$dev" != "--" ] || continue
		[ "$state" = "connected" ] || continue
		case "$type" in
			ethernet|wifi|wwan|bt|vlan) ;;
			*) continue ;;
		esac
		case "$dev" in
			lo|docker*|br-*|veth*|virbr*|tun*|tap*|wg*|tailscale*) continue ;;
		esac
		conn="$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null || true)"
		if [ -n "$conn" ] && [ "$conn" != "--" ]; then
			ctype="$(nmcli -g connection.type connection show "$conn" 2>/dev/null || true)"
			case "$ctype" in
				vpn|wireguard|tun) continue ;;
			esac
		fi
		gw="$(nmcli -g IP4.GATEWAY device show "$dev" 2>/dev/null || true)"
		addr="$(nmcli -g IP4.ADDRESS device show "$dev" 2>/dev/null | head -1 | cut -d/ -f1)"
		[ -n "$gw" ] && [ "$gw" != "--" ] && [ -n "$addr" ] || continue
		printf '%s %s %s\n' "$dev" "$gw" "$addr"
	done
}

link_healthy() {
	addr="$1"
	for host in $CHECK_HOSTS; do
		case "$host" in
			''|*[!0-9.]*) continue ;;
		esac
		if ping -n -I "$addr" -c 1 -W 2 "$host" >/dev/null 2>&1; then
			return 0
		fi
	done
	return 1
}

apply_routes() {
	load_conf
	if [ "$ENABLED" != "yes" ]; then
		clear_route
		log "disabled; normal routing"
		return 0
	fi
	if vpn_owns_default; then
		clear_route
		log "a VPN owns the default route; leaving it alone"
		return 0
	fi
	devs=()
	gws=()
	while read -r dev gw addr; do
		[ -n "$dev" ] || continue
		if link_healthy "$addr"; then
			devs+=("$dev")
			gws+=("$gw")
			log "$dev via $gw is healthy"
		else
			log "$dev via $gw has no internet; left out of the route"
		fi
	done < <(list_uplinks)
	if [ "${#devs[@]}" -lt 2 ]; then
		clear_route
		log "fewer than two healthy links; normal routing"
		return 0
	fi
	args=(route replace default metric "$METRIC" proto static)
	i=0
	while [ "$i" -lt "${#devs[@]}" ]; do
		args+=(nexthop via "${gws[$i]}" dev "${devs[$i]}" weight 1)
		i=$((i + 1))
	done
	if ip "${args[@]}"; then
		log "multipath default route installed (${#devs[@]} links, equal weight)"
	else
		log "could not install the multipath route"
		return 1
	fi
}

status_cmd() {
	load_conf
	echo "Multi-WAN: ${ENABLED}"
	echo "This spreads new connections across links. It is not single-stream bonding."
	echo "Check hosts: ${CHECK_HOSTS}"
	if vpn_owns_default; then
		echo "VPN: owns the default route, so multi-WAN is standing aside"
	else
		echo "VPN: none that takes the default route"
	fi
	echo "Uplinks:"
	found=0
	while read -r dev gw addr; do
		[ -n "$dev" ] || continue
		found=1
		if link_healthy "$addr"; then
			echo "  $dev via $gw ($addr) healthy"
		else
			echo "  $dev via $gw ($addr) no internet"
		fi
	done < <(list_uplinks)
	if [ "$found" = 0 ]; then
		echo "  none"
	fi
	echo "Default routes:"
	ip route show default 2>/dev/null || echo "  none"
}

usage() {
	echo "Usage: cyberdeck-multiwan status|apply|on|off"
}

main() {
	cmd="${1:-status}"
	case "$cmd" in
		status) status_cmd ;;
		apply)
			exec 9>"$LOCK"
			flock -w 20 9 || exit 0
			apply_routes
			;;
		on)
			set_enabled yes
			exec 9>"$LOCK"
			flock -w 20 9 || exit 0
			apply_routes
			status_cmd
			;;
		off)
			set_enabled no
			exec 9>"$LOCK"
			flock -w 20 9 || exit 0
			apply_routes
			status_cmd
			;;
		*) usage; exit 1 ;;
	esac
}

main "$@"
