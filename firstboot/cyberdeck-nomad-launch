#!/bin/sh
# Open Project Nomad Setup in a terminal so sudo can ask for the password.
# Autostart calls this with no arguments. The menu passes --force.
set -eu
if [ "${1:-}" != "--force" ]; then
	if [ -d /run/live/medium ]; then
		exit 0
	fi
	if [ -e /var/lib/cyberdeck/nomad.done ]; then
		exit 0
	fi
fi
if [ ! -t 1 ] && command -v konsole >/dev/null 2>&1; then
	exec konsole --hold -e pkexec /usr/sbin/cyberdeck-nomad-setup --force
fi
echo "Approve the prompt to continue. If it asks in this window, nothing will show as you type."
exec pkexec /usr/sbin/cyberdeck-nomad-setup --force
